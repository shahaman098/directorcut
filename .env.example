# Twitch channel name, without #. Not required for --simulate.
TWITCH_CHANNEL=
# Leave both blank to read chat anonymously. A bot identity enables replies.
TWITCH_BOT_USERNAME=
TWITCH_OAUTH_TOKEN=

# Any OpenAI-compatible /v1 endpoint. Empty key sends no Authorization header.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=4000
# Local Ollama example: LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2

PORT=3000
TRIGGER_COMMAND=!cutscene
COOLDOWN_SECONDS=20
# Hype tokens in a rolling 30-second window; 0 disables automatic scenes.
HYPE_THRESHOLD=0

# Output safety: auto uses the OpenAI moderation API when a key is set (fail closed);
# the blocklist applies either way. TRIGGER_ROLE gates !cutscene to everyone|subs|vips|mods.
MODERATION=auto
TRIGGER_ROLE=everyone
# BLOCKLIST_FILE=./blocklist.txt

# OBS WebSocket v5 (Tools → WebSocket Server Settings in OBS 28+). Enables the vision
# director and the replay trigger. Leave OBS_URL blank to keep both off.
OBS_URL=
# OBS_PASSWORD=
# Screenshot a specific source instead of the whole program scene.
# OBS_SOURCE_NAME=
OBS_TIMEOUT_MS=1500
# DIRECTOR_VISION=on makes the director look at the live frame (needs a vision-capable model).
DIRECTOR_VISION=off

# Channel Points redemptions trigger cutscenes (paid triggers queue; denied ones are
# refunded). Needs a Twitch app Client-Id and a broadcaster user token with
# channel:read:redemptions and channel:manage:redemptions scopes. Blank = off.
TWITCH_CLIENT_ID=
TWITCH_USER_TOKEN=
# Optional when the token is the broadcaster's own: TWITCH_BROADCASTER_ID=
# Comma-separated reward titles to react to; blank reacts to every redemption.
# REWARD_TITLES=EXECUTIVE PRODUCER,CUTSCENE
